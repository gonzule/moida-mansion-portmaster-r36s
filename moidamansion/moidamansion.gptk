left_analog_right = right

# Physical Bottom button (labeled 'B' on R36S) -> key b (search/select)
a = b

# Physical Top button (labeled 'X' on R36S) -> key x (climb stairs)
x = x

# Physical Right button (labeled 'A' on R36S) -> disabled
b = \"\"

# Physical Left button (labeled 'Y' on R36S) -> disabled
y = \"\"

l1 = \"\"
r1 = \"\"
